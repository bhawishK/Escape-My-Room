# Server settings and API keys, read by Python when the service starts.
# Copy this file to `.env` (which git ignores) and fill in the values.
# A variable already set in the shell wins over this file.
# Keys stay on the server: they never reach the page, a job record, a log or a stored file.

# --- API keys ---------------------------------------------------------------------------------

# OpenRouter key for Qwen (issue #28). Testing key with a $1 limit.
OPENROUTER_API_KEY=

# --- Room preparation -------------------------------------------------------------------------

# `openrouter` asks Qwen for the overview's objects, `fixture` copies a fixed room for
# development; leave it empty to turn preparation off.
ESCAPE_ROOM_PREPARATION_WORKER=openrouter

# Optional OpenRouter settings, shown with their defaults.
# ESCAPE_ROOM_OPENROUTER_MODEL=qwen/qwen3-vl-8b-instruct
# ESCAPE_ROOM_OPENROUTER_MAX_IMAGE_SIDE=1280
# ESCAPE_ROOM_OPENROUTER_MAX_OUTPUT_TOKENS=2048
# ESCAPE_ROOM_OPENROUTER_MAX_REPAIRS=2
# ESCAPE_ROOM_OPENROUTER_TIMEOUT_SECONDS=120

# --- Other server settings, shown with their defaults ------------------------------------------

# ESCAPE_ROOM_DATA_DIR=data
# ESCAPE_ROOM_PREPARED_DIR=assets/prepared-room
# A room trained from a video (assets/splat-room/build_room.py writes it):
# ESCAPE_ROOM_PREPARED_DIR=data/splat-room
# ESCAPE_ROOM_SIMULATED_DELAY_MS=0
